# basalt.toml — configuração do Basalt (copia para ./basalt.toml, ~/.config/basalt/basalt.toml ou /etc/basalt/basalt.toml;
# ou aponta BASALT_CONFIG). As variáveis de ambiente BASALT_* vencem sempre o que está aqui.

[basalt]
dados = "/var/lib/basalt"          # raiz: <dados>/<espaco>/{memoria,copia,dados}; memoria/ é um cofre Obsidian
porta = 8121
escutar = "127.0.0.1"              # põe um proxy (nginx/caddy) com HTTPS à frente; nunca 0.0.0.0 sem HTTPS
lingua = "pt"
git = true                         # fotografias git da memória: histórico, diário, desfazer fusões (precisa do `git`)

[git]                              # quem assina as fotografias git da memória
nome = "Basalt"
email = "basalt@localhost"

[auth]
modo = "senha"                     # senha = formulário próprio · cabecalho = o proxy já faz login (SSO) e manda o e-mail
                                   # · aberto = sem login, SÓ com escutar = 127.0.0.1
cabecalho = "X-Basalt-Email"       # modo cabecalho: o proxy TEM de substituir este cabeçalho (nunca o do visitante)
sessao_horas = 336                 # 14 dias
tentativas = 5                     # falhas de login por IP em `janela_minutos`
janela_minutos = 15

[[utilizadores]]
email = "eu@exemplo.pt"
espaco = "eu"                      # pasta <dados>/eu
nome = "Eu"
# senha_hash = "scrypt$…"          # gera com: basalt utilizador senha eu@exemplo.pt
# mcp_token_hash = "…"             # gera com: basalt utilizador mcp-token eu@exemplo.pt (o token só se mostra uma vez)
admin = true

[ia]
fornecedor = "openai"              # nenhum | openai (Ollama, OpenRouter, Mistral, LM Studio…) | anthropic | claude-cli
url = "http://127.0.0.1:11434/v1"  # openai: base da API (Ollama local de origem)
chave_env = "BASALT_IA_CHAVE"      # NOME da variável de ambiente com a chave; a chave nunca se escreve aqui
# chave_ficheiro = "/etc/basalt/ia.chave"   # ou um ficheiro só de leitura do utilizador do serviço (0600)
modelo_chat = "qwen2.5:7b"
tempo_limite = 120
propostas_por_hora = 12            # propostas de junção pela IA
pedidos_por_hora = 40              # IA no editor (resumir, reescrever, corrigir, continuar)
texto_maximo = 6000                # caracteres por pedido ao editor

[ia.embeddings]                    # pesquisa por significado; sem isto a pesquisa é por palavras (BM25), sem IA
fornecedor = "ollama"              # ollama (http://host:11434, /api/embeddings) | openai (…/v1, /embeddings) | nenhum
url = "http://127.0.0.1:11434"
modelo = "nomic-embed-text"

[entrada]
automatica = true                  # ideias de fontes de confiança são arrumadas sozinhas (com Desfazer)
fontes_de_confianca = ["web", "terminal", "cli", "mcp"]
# [entrada.telegram]               # opcional: guardar ideias por um bot Telegram
# token_env = "BASALT_TG_TOKEN"
# chats = ["123456789"]

# [categorias]                     # opcional: as TUAS categorias (a IA escolhe 1-2 por nota) e regras seguras pelo nome da nota
# regras = [["^trabalho|reuniao", "Trabalho"], ["receita|cozinha", "Casa"]]
# [categorias.lista]
# "Trabalho" = "projectos, clientes, reuniões"
# "Casa" = "casa, família, compras"
# "Diversos" = "nada acima encaixa"

# [fontes_extra]                   # opcional: comandos que imprimem JSON [{"fonte","ref","titulo","texto"}] para entrar no índice
# comandos = ["/usr/local/bin/as-minhas-tarefas"]
